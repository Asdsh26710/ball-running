# Unity .gitignore — 放在项目根目录（与 Assets/ 同级）
# 来源：github/gitignore Unity.gitignore + Unity 2022.3 补充

# ===== Unity 生成的目录，绝对不能提交 =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Assets 里的 .meta 必须提交（Unity 靠它维持引用关系）
!/[Aa]ssets/**/*.meta

# ===== 编辑器 / IDE 自动生成 =====
.vs/
.gradle/
.consulo/
.vscode/
.idea/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ===== 构建产物 =====
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# ===== 系统垃圾 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Addressables 临时数据 =====
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
